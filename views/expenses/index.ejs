<%- include('../partials/header') %>

<div class="page-intro">
  <div>
    <h1>Expenses</h1>
    <p><%= expenses.length.toLocaleString('en') %> <%= expenses.length === 1 ? 'expense' : 'expenses' %> shown</p>
  </div>
  <a href="/expenses/new" class="btn btn-dark"><span aria-hidden="true">+</span> Add expense</a>
</div>

<section class="ledger-panel filters" aria-label="Expense filters">
  <form method="get" action="/expenses" class="filter-grid">
    <div>
      <label for="q" class="form-label">Search by title</label>
      <input type="search" id="q" name="q" class="form-control" placeholder="e.g. Groceries" value="<%= filters.q %>" maxlength="100">
    </div>
    <div>
      <label for="category" class="form-label">Category</label>
      <select id="category" name="category" class="form-select">
        <option value="">All categories</option>
        <% for (const category of categories) { %>
          <option value="<%= category.id %>" <%= filters.category === category.id ? 'selected' : '' %>><%= category.name %></option>
        <% } %>
      </select>
    </div>
    <div>
      <label for="month" class="form-label">Month</label>
      <select id="month" name="month" class="form-select">
        <option value="">All months</option>
        <% for (const month of months) { %>
          <option value="<%= month %>" <%= filters.month === month ? 'selected' : '' %>><%= formatMonth(month) %></option>
        <% } %>
      </select>
    </div>
    <div>
      <label for="sort" class="form-label">Date order</label>
      <select id="sort" name="sort" class="form-select">
        <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest first</option>
        <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Oldest first</option>
      </select>
    </div>
    <div class="filter-actions">
      <button type="submit" class="btn btn-light border">Apply filters</button>
      <% if (filters.q || filters.category || filters.month || filters.sort === 'oldest') { %>
        <a class="text-link" href="/expenses">Reset</a>
      <% } %>
    </div>
  </form>
</section>

<section class="ledger-panel table-panel" aria-labelledby="expense-heading">
  <h2 id="expense-heading" class="visually-hidden">Expense list</h2>
  <% if (expenses.length) { %>
    <div class="table-responsive">
      <table class="table ledger-table align-middle mb-0" role="table" aria-labelledby="expense-heading">
        <thead role="rowgroup">
          <tr role="row">
            <th scope="col" role="columnheader">Expense</th>
            <th scope="col" role="columnheader">Category</th>
            <th scope="col" role="columnheader">Date</th>
            <th scope="col" role="columnheader" class="text-end">Amount</th>
            <th scope="col" role="columnheader" class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          <% for (const expense of expenses) { %>
            <tr role="row">
              <th scope="row" role="rowheader">
                <div class="expense-title"><%= expense.title %></div>
                <% if (expense.description) { %>
                  <div class="expense-description"><%= expense.description %></div>
                <% } %>
              </th>
              <td role="cell" class="expense-category"><span class="category-label"><%= expense.category_name %></span></td>
              <td role="cell" class="expense-date"><time datetime="<%= expense.date %>"><%= formatDate(expense.date) %></time></td>
              <td role="cell" class="text-end money"><small>EGP</small> <%= formatAmount(expense.amount_cents) %></td>
              <td role="cell" class="text-end expense-actions">
                <div class="row-actions">
                  <a class="text-link" href="/expenses/<%= expense.id %>/edit" aria-label="Edit <%= expense.title %>">Edit</a>
                  <a class="text-link muted" href="/expenses/<%= expense.id %>/delete" aria-label="Delete <%= expense.title %>">Delete</a>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } else if (filters.q || filters.category || filters.month) { %>
    <p class="empty-state">No expenses match these filters. <a href="/expenses" class="text-link">Clear filters</a>.</p>
  <% } else { %>
    <p class="empty-state">No expenses yet. <a href="/expenses/new" class="text-link">Add an expense</a> to start your ledger.</p>
  <% } %>
</section>

<%- include('../partials/footer') %>
