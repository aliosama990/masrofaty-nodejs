<%- include('partials/header') %>

<div class="page-intro">
  <h1>Dashboard</h1>
  <a href="/expenses/new" class="btn btn-dark"><span aria-hidden="true">+</span> Add expense</a>
</div>

<section class="ledger-panel summary" aria-label="Expense summary">
  <div class="metric">
    <h2>This month</h2>
    <p data-summary="month" class="metric-number"><small>EGP</small> <%= formatAmount(monthTotal) %></p>
    <p class="metric-note"><%= formatMonth(month) %></p>
  </div>
  <div class="metric">
    <h2>Total expenses</h2>
    <p data-summary="total" class="metric-number"><small>EGP</small> <%= formatAmount(total) %></p>
    <p class="metric-note">All time</p>
  </div>
  <div class="metric">
    <h2>Transactions</h2>
    <p data-summary="count" class="metric-number"><%= count.toLocaleString('en') %></p>
    <p class="metric-note">All time</p>
  </div>
</section>

<div class="dashboard-grid">
  <section class="ledger-panel" aria-labelledby="recent-heading">
    <div class="panel-heading">
      <h2 id="recent-heading">Recent expenses</h2>
      <a class="text-link" href="/expenses">View all <span aria-hidden="true">→</span></a>
    </div>
    <% if (recent.length) { %>
      <ul class="entry-list">
        <% for (const expense of recent) { %>
          <li class="entry">
            <div class="entry-copy">
              <a class="entry-title" href="/expenses/<%= expense.id %>/edit"><%= expense.title %></a>
              <div class="entry-meta"><%= expense.category_name %> <span aria-hidden="true">·</span> <time datetime="<%= expense.date %>"><%= formatDate(expense.date) %></time></div>
            </div>
            <div class="money"><small>EGP</small> <%= formatAmount(expense.amount_cents) %></div>
          </li>
        <% } %>
      </ul>
    <% } else { %>
      <p class="empty-state">Your ledger is empty. <a class="text-link" href="/expenses/new">Add your first expense</a>.</p>
    <% } %>
  </section>

  <section class="ledger-panel" aria-labelledby="category-heading">
    <div class="panel-heading">
      <h2 id="category-heading">Spending by category</h2>
      <span class="muted">All time</span>
    </div>
    <% if (byCategory.length) { %>
      <ul class="category-breakdown">
        <% for (const category of byCategory) { %>
          <% const share = (category.total / total * 100).toFixed(1); %>
          <li>
            <div class="chart-label">
              <span><%= category.name %></span>
              <span class="money"><small>EGP</small> <%= formatAmount(category.total) %></span>
            </div>
            <div class="chart-track" role="meter" aria-label="<%= category.name %> share of total spending" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= share %>" aria-valuetext="<%= share %>%">
              <span style="width: <%= share %>%"></span>
            </div>
          </li>
        <% } %>
      </ul>
    <% } else { %>
      <p class="empty-state">Category totals appear after you add an expense.</p>
    <% } %>
  </section>
</div>

<%- include('partials/footer') %>
